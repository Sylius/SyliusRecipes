{
    "aliases": ["product-configurator"],
    "bundles": {
        "Sylius\\ProductCustomization\\SyliusProductCustomization": ["all"]
    },
    "copy-from-recipe": {
        "config/": "%CONFIG_DIR%/"
    },
    "add-lines": [
        {
            "file": "assets/shop/entrypoint.js",
            "content": "import '@vendor/sylius/product-configurator-plugin/assets/shop/entrypoint';",
            "position": "bottom",
            "warn_if_missing": true
        }
    ]
}
